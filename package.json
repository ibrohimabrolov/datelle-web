{
  "name": "chaman-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/predeploy.ts && tsx scripts/telegram-setup.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/server/seed.ts",
    "test:api": "tsx --env-file=.env.local --test tests/api.test.ts",
    "test": "tsx --test tests/unit.test.ts tests/telegram.test.ts",
    "db:deploy": "tsx --env-file=.env.local scripts/predeploy.ts",
    "bot:setup": "tsx --env-file=.env.local scripts/telegram-setup.ts --force"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
