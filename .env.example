# Postgres connection (production: a database hosted in Uzbekistan — personal data law)
DATABASE_URL=postgresql://user:password@host:5432/datelle
DB_POOL_MAX=5

# SMS: "console" (dev — code printed to server log) or "eskiz"
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Secret mixed into OTP hashes. Long random string in production.
OTP_PEPPER=

# Admin panel (/admin). Empty = admin disabled (404).
ADMIN_PASSWORD=

# Datelle Studio — Telegram bot (all optional; without them the bot and cron are off → 503)
# From @BotFather. Never commit.
TELEGRAM_BOT_TOKEN=
# Optional. Empty = derived from the token. If set: 32–256 chars, only A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". 16+ random chars.
CRON_SECRET=
# Public bot username without @ (t.me links, Login Widget)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Optional Mini App entry, defaults to <site>/panel
TELEGRAM_MINIAPP_URL=
